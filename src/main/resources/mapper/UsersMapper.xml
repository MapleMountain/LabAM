<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cg.mapper.UsersMapper">

    <resultMap id="BaseResultMap" type="com.cg.pojo.Users">
            <id property="userId" column="user_id" jdbcType="INTEGER"/>
            <result property="username" column="username" jdbcType="VARCHAR"/>
            <result property="password" column="password" jdbcType="VARCHAR"/>
            <result property="role" column="role" jdbcType="OTHER"/>
            <result property="collegeId" column="college_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id,username,password,
        role,college_id
    </sql>
    <select id="userList" resultType="com.cg.pojo.Users">
        SELECT u.*, c.college_name
        FROM users u
                 LEFT JOIN colleges c ON u.college_id = c.college_id
    </select>
    <select id="getOne" resultType="com.cg.pojo.Users">
        SELECT u.*, c.college_name
        FROM users u
                 LEFT JOIN colleges c ON u.college_id = c.college_id where u.user_id=#{id}
    </select>
</mapper>
